{
  "name": "bilan-carbone-pdf",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22.16.0",
    "yarn": "1.22"
  },
  "scripts": {
    "dev": "nodemon src/index.ts",
    "build": "tsc",
